{
  "name": "Дуу Орчуулагч",
  "short_name": "Орчуулагч",
  "description": "Монгол яриаг хятад, орос, англи хэлээр дуу болгож орчуулна. Ирсэн дуут мессежийг монгол руу орчуулна.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#000000",
  "theme_color": "#000000",
  "lang": "mn",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{ "name": "audio", "accept": ["audio/*", ".ogg", ".opus", ".oga", ".m4a", ".mp3", ".aac", ".amr", ".wav"] }]
    }
  }
